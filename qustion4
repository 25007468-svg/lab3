import java.util.Random;

public class L3Q4 {
    public static void main(String[] args) {
        Random rand = new Random();
        
        // Player 1 rolls
        int p1Roll1 = rand.nextInt(6) + 1;
        int p1Roll2 = rand.nextInt(6) + 1;
        int p1Score = p1Roll1 + p1Roll2;
        
        // Player 2 rolls
        int p2Roll1 = rand.nextInt(6) + 1;
        int p2Roll2 = rand.nextInt(6) + 1;
        int p2Score = p2Roll1 + p2Roll2;
        
        System.out.printf("Player 1 rolled %d and %d. Total score: %d\n", p1Roll1, p1Roll2, p1Score);
        System.out.printf("Player 2 rolled %d and %d. Total score: %d\n", p2Roll1, p2Roll2, p2Score);
        
        if (p1Score > p2Score) {
            System.out.println("Player 1 wins!");
        } else if (p2Score > p1Score) {
            System.out.println("Player 2 wins!");
        } else {
            System.out.println("It's a tie!");
        }
    }
}
